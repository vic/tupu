# Types family cases (sourced by run.sh; vic/spec/rules.md 9, types.md). Expected rows are in expected.txt.
yv() { verdict types "$1" "${2:-}" types; }
ty() { mk "$1"; }
ty mismatchOk; f expects 'e1 T1'; f typeOf 'e1 T1'
ty mismatchBad; f expects 'e1 T1'; f typeOf 'e1 T2'
ty inferOk; f needsInference e1; f inferredType 'e1 T1'
ty inferTwo; f needsInference e1; f inferredType 'e1 T1' 'e1 T2'
ty inferNone; f needsInference e1
ty arityOk; f arityUse 'a1 Value 2 2' 'a2 Type 1 1' 'a3 Pattern 3 3'
ty arityBad; f arityUse 'a1 Value 2 3' 'a2 Type 1 2' 'a3 Pattern 3 2'
ty linear; f lengthTerm l1 l2; f linearForm l2
ty recursive; f typeDecl A B C D; f inlineField 'A A' 'B C' 'C B'
# ruling S69: the element type of an Array or Cell field counts; a table of nodes with U64 indexes does not
ty recArray; f typeDecl Node; f elementField 'Node Node'
ty recMixed; f typeDecl A B; f elementField 'A B'; f inlineField 'B A'
ty treeOk; f typeDecl Tree Node; f elementField 'Tree Node'
ty fuel; f evaluation 'e1 TypeArgument OutOfFuel' 'e2 Value OutOfFuel' 'e3 Value ReachesExtern' 'e4 Value Done' 'e5 TypeArgument Done'
ty matchCases; f matchOver m1 m2 m3; f enumCase 'm1 K1' 'm1 K2' 'm2 K1' 'm2 K2' 'm3 K1'; f armCase 'm1 a1 K1' 'm1 a2 K2' 'm2 a3 K1' 'm3 a4 K1' 'm3 a5 K1'
ty wildcard; f wildcardArm 'm1 Integer' 'm2 Enum'
ty nested; f patternDepth 'a1 1' 'a2 2'
ty assign; f assignTo 'a1 v1' 'a2 v2'; f isVar v1
ty handlerSig; f handlerImpl 'h1 op1' 'h2 op2'; f sigOf 'h1 S1' 'op1 S1' 'h2 S2' 'op2 S1'
ty externForge; f externDecl d1 d2; f externCarriesFacts d2
for x in mismatchOk mismatchBad inferOk inferTwo inferNone arityOk arityBad linear recursive recArray recMixed treeOk fuel matchCases wildcard nested assign handlerSig externForge; do yv $x; done
yv mismatchBad -MMUTANT_MISMATCHOFF
yv inferTwo -MMUTANT_INFEROFF
yv arityBad -MMUTANT_ARITYOFF
yv linear -MMUTANT_LINEAROFF
yv recursive -MMUTANT_RECDIRECT
yv recArray -MMUTANT_NOELEMENT
yv recMixed -MMUTANT_NOELEMENT
yv fuel -MMUTANT_FUELOFF
yv fuel -MMUTANT_EXTERNEVALOFF
yv matchCases -MMUTANT_MISSINGCASEOFF
yv matchCases -MMUTANT_DUPCASEOFF
yv wildcard -MMUTANT_WILDOFF
yv nested -MMUTANT_NESTOFF
yv assign -MMUTANT_ASSIGNOFF
yv handlerSig -MMUTANT_SIGOFF
yv externForge -MMUTANT_FORGEOFF
